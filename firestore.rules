rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---
    
    function incoming() {
      return request.resource.data;
    }
    
    function isString(val) {
      return val is string;
    }
    
    function isNum(val) {
      return val is int || val is float;
    }
    
    function isBool(val) {
      return val is bool;
    }
    
    function isList(val) {
      return val is list;
    }

    // --- Master Gates for Each Collection ---

    function isValidUser(data) {
      return isString(data.id) &&
             isString(data.name) &&
             isString(data.email) &&
             (data.role == 'Administrator' || data.role == 'Accountant' || data.role == 'Teacher' || data.role == 'Headmaster') &&
             isBool(data.mfaEnabled);
    }

    function isValidStudent(data) {
      return isString(data.id) &&
             isString(data.name) &&
             isString(data.class) &&
             (data.category == 'Pre-school' || data.category == 'Primary' || data.category == 'JHS') &&
             isString(data.rollNumber) &&
             isBool(data.active) &&
             isString(data.guardianPhone);
    }

    function isValidPayment(data) {
      return isString(data.id) &&
             isString(data.studentId) &&
             isString(data.studentName) &&
             isString(data.class) &&
             isString(data.category) &&
             isNum(data.amount) && data.amount > 0 &&
             isString(data.date) &&
             isString(data.timestamp) &&
             isString(data.collectedBy) &&
             isBool(data.verified);
    }

    function isValidExpense(data) {
      return isString(data.id) &&
             isString(data.date) &&
             isNum(data.amount) && data.amount > 0 &&
             (data.category == 'Food' || data.category == 'Utilities' || data.category == 'Utility' || data.category == 'Maintenance' || data.category == 'Transport' || data.category == 'Supplies' || data.category == 'Uniforms' || data.category == 'Payroll' || data.category == 'Others') &&
             isString(data.description) &&
             isString(data.approvedBy) &&
             isString(data.timestamp);
    }

    function isValidWorkerSalary(data) {
      return isString(data.id) &&
             isString(data.date) &&
             isString(data.workerName) &&
             isString(data.monthYear) &&
             isString(data.role) &&
             isNum(data.baseSalary) && data.baseSalary >= 0 &&
             isNum(data.allowance) && data.allowance >= 0 &&
             isNum(data.deduction) && data.deduction >= 0 &&
             isNum(data.netPaid) && data.netPaid >= 0 &&
             (data.paymentMethod == 'Cash' || data.paymentMethod == 'Mobile Money' || data.paymentMethod == 'Bank Transfer') &&
             isString(data.timestamp) &&
             // Invariant Formula validation: netPaid = baseSalary + allowance - deduction
             data.netPaid == data.baseSalary + data.allowance - data.deduction;
    }

    function isValidBudgetTarget(data) {
      return isString(data.id) &&
             isString(data.itemName) &&
             isNum(data.targetAmount) && data.targetAmount > 0 &&
             isNum(data.savedPercentage) && data.savedPercentage >= 0 && data.savedPercentage <= 100 &&
             isString(data.createdAt) &&
             isBool(data.active) &&
             isBool(data.completed);
    }

    function isValidExamsPayment(data) {
      return isString(data.id) &&
             isString(data.studentId) &&
             isString(data.studentName) &&
             isString(data.class) &&
             isString(data.category) &&
             isNum(data.amountPaid) && data.amountPaid > 0 &&
             isString(data.datePaid) &&
             isString(data.collectedBy) &&
             isString(data.termId) &&
             isString(data.paymentMethod) &&
             isString(data.timestamp);
    }

    function isValidExamsExpense(data) {
      return isString(data.id) &&
             isString(data.providerName) &&
             isString(data.date) &&
             isString(data.targetClass) &&
             isNum(data.billingPerChild) && data.billingPerChild >= 0 &&
             isNum(data.studentCount) && data.studentCount >= 0 &&
             isNum(data.totalAmount) && data.totalAmount >= 0 &&
             isNum(data.amountPaid) && data.amountPaid >= 0 &&
             isString(data.status) &&
             isString(data.timestamp) &&
             // Invariant Formula validation:
             // If publisher exam: billingPerChild > 0, totalAmount = billingPerChild * studentCount
             // If other expense: billingPerChild = 0, studentCount = 0, totalAmount can be anything >= 0
             (data.billingPerChild == 0 ? (data.studentCount == 0 && data.totalAmount >= 0) : (data.totalAmount == data.billingPerChild * data.studentCount));
    }

    function isValidExamsSettings(data) {
      return data.classFees is map;
    }

    function isValidTerm(data) {
      return isString(data.id) &&
             isString(data.name) &&
             isString(data.startDate) &&
             isNum(data.daysCount) && data.daysCount > 0 &&
             isList(data.schoolDays) &&
             isBool(data.active);
    }

    function isValidTeacherEvaluation(data) {
      return isString(data.id) &&
             isString(data.teacherId) &&
             isString(data.teacherName) &&
             isString(data.monthYear) &&
             (data.attendanceScore == 'Excellent' || data.attendanceScore == 'Good' || data.attendanceScore == 'Fair' || data.attendanceScore == 'Poor') &&
             (data.punctualityScore == 'Excellent' || data.punctualityScore == 'Good' || data.punctualityScore == 'Fair' || data.punctualityScore == 'Poor') &&
             isList(data.checkedEthics) &&
             isNum(data.calculatedDeduction) && data.calculatedDeduction >= 0 &&
             isNum(data.calculatedBenefit) && data.calculatedBenefit >= 0 &&
             isString(data.dateCreated);
    }

    function isValidAuditLog(data) {
      return isString(data.id) &&
             isString(data.timestamp) &&
             isString(data.action) &&
             (data.category == 'students' || data.category == 'payments' || data.category == 'expenses' || data.category == 'settings' || data.category == 'security' || data.category == 'other') &&
             isString(data.operatorName) &&
             isString(data.operatorRole) &&
             isString(data.details);
    }

    // --- Path Mappings ---

    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidUser(incoming());
      allow delete: if true;
    }

    match /students/{studentId} {
      allow read: if true;
      allow create, update: if isValidStudent(incoming());
      allow delete: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if isValidPayment(incoming());
      allow delete: if true;
    }

    match /expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidExpense(incoming());
      allow delete: if true;
    }

    match /salaries/{salaryId} {
      allow read: if true;
      allow create, update: if isValidWorkerSalary(incoming());
      allow delete: if true;
    }

    match /budget_targets/{targetId} {
      allow read: if true;
      allow create, update: if isValidBudgetTarget(incoming());
      allow delete: if true;
    }

    match /exams_payments/{paymentId} {
      allow read: if true;
      allow create, update: if isValidExamsPayment(incoming());
      allow delete: if true;
    }

    match /exams_expenses/{expenseId} {
      allow read: if true;
      allow create, update: if isValidExamsExpense(incoming());
      allow delete: if true;
    }

    match /exams_settings/{settingsId} {
      allow read: if true;
      allow create, update: if isValidExamsSettings(incoming());
      allow delete: if true;
    }

    match /terms/{termId} {
      allow read: if true;
      allow create, update: if isValidTerm(incoming());
      allow delete: if true;
    }

    match /teacher_evaluations/{evaluationId} {
      allow read: if true;
      allow create, update: if isValidTeacherEvaluation(incoming());
      allow delete: if true;
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow create, update: if isValidAuditLog(incoming());
      allow delete: if true;
    }
  }
}
