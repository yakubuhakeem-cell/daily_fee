{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "App staff and administrative users",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID" },
        "name": { "type": "string", "description": "User display name" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "role": { "type": "string", "enum": ["Administrator", "Accountant", "Teacher", "Headmaster"], "description": "Staff access role" },
        "assignedClass": { "type": "string", "description": "Assigned class if the user is a Teacher" },
        "assignedClasses": { "type": "array", "description": "Assigned classes if the user is a Teacher with multiple gates" },
        "mfaEnabled": { "type": "boolean", "description": "Whether MFA is enabled or not" },
        "mfaSecret": { "type": "string", "description": "Secret token for MFA" }
      },
      "required": ["id", "name", "email", "role", "mfaEnabled"]
    },
    "Student": {
      "title": "Student",
      "description": "Registered students",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique student ID" },
        "name": { "type": "string", "description": "Student full name" },
        "class": { "type": "string", "description": "Assigned class grade" },
        "category": { "type": "string", "enum": ["Pre-school", "Primary", "JHS"], "description": "School level category" },
        "rollNumber": { "type": "string", "description": "Official roll code" },
        "active": { "type": "boolean", "description": "Student active status" },
        "guardianPhone": { "type": "string", "description": "Guardian phone contact code" },
        "photoUrl": { "type": "string", "description": "Base64 encoded student photo data or custom avatar url links" },
        "discount": { "type": "number", "description": "Optional daily check-in discount amount" },
        "gender": { "type": "string", "enum": ["Male", "Female"], "description": "Student gender" },
        "paymentType": { "type": "string", "enum": ["Daily", "Term"], "description": "Billing calculation model: daily vs static term subscription" },
        "termFee": { "type": "number", "description": "Fixed fee for entire school term for Term Payer" },
        "legacyDebt": { "type": "number", "description": "Pre-adoption / outstanding legacy debt to be integrated into system balance" }
      },
      "required": ["id", "name", "class", "category", "rollNumber", "active", "guardianPhone"]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Daily registration payments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique payment ID" },
        "studentId": { "type": "string", "description": "Referenced student ID" },
        "studentName": { "type": "string", "description": "Student name at time of payment" },
        "class": { "type": "string", "description": "Class grade at payment time" },
        "category": { "type": "string", "description": "School level category at payment time" },
        "amount": { "type": "number", "description": "Paid amount in GHC" },
        "date": { "type": "string", "description": "Payment index date (YYYY-MM-DD)" },
        "timestamp": { "type": "string", "description": "ISO timestamp of check-in" },
        "collectedBy": { "type": "string", "description": "Name of collector" },
        "verified": { "type": "boolean", "description": "Instant verification status" }
      },
      "required": ["id", "studentId", "studentName", "class", "category", "amount", "date", "timestamp", "collectedBy", "verified"]
    },
    "Expense": {
      "title": "Expense",
      "description": "Daily school expenses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique expense ID" },
        "date": { "type": "string", "description": "Expense date (YYYY-MM-DD)" },
        "amount": { "type": "number", "description": "Expense amount in GHC" },
        "category": { "type": "string", "enum": ["Food", "Utilities", "Maintenance", "Transport", "Supplies", "Uniforms", "Others"], "description": "Expense category classification" },
        "description": { "type": "string", "description": "Details of the expense" },
        "approvedBy": { "type": "string", "description": "Name of approving staff member" },
        "timestamp": { "type": "string", "description": "ISO timestamp of creation" }
      },
      "required": ["id", "date", "amount", "category", "description", "approvedBy", "timestamp"]
    },
    "WorkerSalary": {
      "title": "WorkerSalary",
      "description": "Workers salary payments with calculation formula: netPaid = baseSalary + allowance - deduction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique salary payment ID" },
        "date": { "type": "string", "description": "Payment execution date (YYYY-MM-DD)" },
        "workerName": { "type": "string", "description": "Worker full name" },
        "userId": { "type": "string", "description": "Optional staff account ID" },
        "monthYear": { "type": "string", "description": "Reference month (e.g. June 2026)" },
        "role": { "type": "string", "description": "Worker job role" },
        "baseSalary": { "type": "number", "description": "Base salary in GHC" },
        "allowance": { "type": "number", "description": "Allowances / bonuses in GHC" },
        "deduction": { "type": "number", "description": "Deductions in GHC" },
        "netPaid": { "type": "number", "description": "Total net GHC paid (baseSalary + allowance - deduction)" },
        "paymentMethod": { "type": "string", "enum": ["Cash", "Mobile Money", "Bank Transfer"], "description": "Mode of payment" },
        "notes": { "type": "string", "description": "Reference or personal notes" },
        "timestamp": { "type": "string", "description": "ISO timestamp of payment" }
      },
      "required": ["id", "date", "workerName", "monthYear", "role", "baseSalary", "allowance", "deduction", "netPaid", "paymentMethod", "timestamp"]
    },
    "BudgetTarget": {
      "title": "BudgetTarget",
      "description": "Savings action plans for buying target properties using daily received fee percentages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique target item ID" },
        "itemName": { "type": "string", "description": "Name of target item, e.g. School bus" },
        "targetAmount": { "type": "number", "description": "Target purchase cost in GHC" },
        "savedPercentage": { "type": "number", "description": "Specified percentage from total daily collections" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "active": { "type": "boolean", "description": "Target active status" },
        "completed": { "type": "boolean", "description": "Flag indicating target is fully funded and bought" },
        "description": { "type": "string", "description": "Extra details and notes" }
      },
      "required": ["id", "itemName", "targetAmount", "savedPercentage", "createdAt", "active", "completed"]
    },
    "ExamsPayment": {
      "title": "ExamsPayment",
      "description": "Student exam fee payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique payment ID" },
        "studentId": { "type": "string", "description": "Student ID reference" },
        "studentName": { "type": "string", "description": "Student name" },
        "class": { "type": "string", "description": "Class grade" },
        "category": { "type": "string", "description": "Level category" },
        "amountPaid": { "type": "number", "description": "GHC paid amount" },
        "datePaid": { "type": "string", "description": "Payment date YYYY-MM-DD" },
        "collectedBy": { "type": "string", "description": "Staff cashier name" },
        "termId": { "type": "string", "description": "Active term ID reference" },
        "paymentMethod": { "type": "string", "description": "Cash/Momo/Bank" },
        "notes": { "type": "string", "description": "Notes" },
        "timestamp": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["id", "studentId", "studentName", "class", "category", "amountPaid", "datePaid", "collectedBy", "termId", "paymentMethod", "timestamp"]
    },
    "ExamsExpense": {
      "title": "ExamsExpense",
      "description": "Exam companies printing invoices logs with formula: totalAmount = billingPerChild * studentCount (when billingPerChild > 0)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique invoice ID" },
        "providerName": { "type": "string", "description": "Exams printing vendor name" },
        "date": { "type": "string", "description": "Billing date YYYY-MM-DD" },
        "targetClass": { "type": "string", "description": "Class scope of printing order" },
        "billingPerChild": { "type": "number", "description": "Publisher cost per child" },
        "studentCount": { "type": "number", "description": "Quantity of assessments ordered" },
        "totalAmount": { "type": "number", "description": "Calculated total cost invoice" },
        "amountPaid": { "type": "number", "description": "Settled amount" },
        "status": { "type": "string", "description": "Payment settlement status" },
        "notes": { "type": "string", "description": "Notes" },
        "timestamp": { "type": "string", "description": "Log timestamp" }
      },
      "required": ["id", "providerName", "date", "targetClass", "billingPerChild", "studentCount", "totalAmount", "amountPaid", "status", "timestamp"]
    },
    "ExamsSettings": {
      "title": "ExamsSettings",
      "description": "Exams default class-level fee standards",
      "type": "object",
      "properties": {
        "classFees": { "type": "object", "description": "JSON map object detailing class fee rules" }
      },
      "required": ["classFees"]
    },
    "Term": {
      "title": "Term",
      "description": "School Terms details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique term ID" },
        "name": { "type": "string", "description": "Term Name" },
        "startDate": { "type": "string", "description": "YYYY-MM-DD date" },
        "daysCount": { "type": "number", "description": "Number of active school days" },
        "schoolDays": { "type": "array", "description": "Array of school dates YYYY-MM-DD" },
        "active": { "type": "boolean", "description": "Whether this is the active term" }
      },
      "required": ["id", "name", "startDate", "daysCount", "schoolDays", "active"]
    },
    "TeacherEvaluation": {
      "title": "TeacherEvaluation",
      "description": "Teacher performance assessment evaluations",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique evaluation ID" },
        "teacherId": { "type": "string", "description": "Teacher staff ID reference" },
        "teacherName": { "type": "string", "description": "Teacher full name" },
        "monthYear": { "type": "string", "description": "Reference month June 2026" },
        "attendanceScore": { "type": "string", "enum": ["Excellent", "Good", "Fair", "Poor"] },
        "punctualityScore": { "type": "string", "enum": ["Excellent", "Good", "Fair", "Poor"] },
        "checkedEthics": { "type": "array", "description": "List of active ethics tags" },
        "calculatedDeduction": { "type": "number", "description": "Total deductions percentage" },
        "calculatedBenefit": { "type": "number", "description": "Total benefits percentage" },
        "dateCreated": { "type": "string", "description": "Date created YYYY-MM-DD" }
      },
      "required": ["id", "teacherId", "teacherName", "monthYear", "attendanceScore", "punctualityScore", "checkedEthics", "calculatedDeduction", "calculatedBenefit", "dateCreated"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System transaction log audit entries",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique log ID" },
        "timestamp": { "type": "string", "description": "ISO timestamp" },
        "action": { "type": "string", "description": "Action designation code" },
        "category": { "type": "string", "enum": ["students", "payments", "expenses", "settings", "security", "other"] },
        "operatorName": { "type": "string", "description": "Dispenser cashier name" },
        "operatorRole": { "type": "string", "description": "Operator role" },
        "details": { "type": "string", "description": "Full details of mutation" }
      },
      "required": ["id", "timestamp", "action", "category", "operatorName", "operatorRole", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "Collection of staff profiles"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of pupil enrollment registry"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Collection of historical fee check-ins"
    },
    "/expenses/{expenseId}": {
      "schema": "Expense",
      "description": "Collection of custom daily expenditures"
    },
    "/salaries/{salaryId}": {
      "schema": "WorkerSalary",
      "description": "Collection of tracking logs of employee wages"
    },
    "/budget_targets/{targetId}": {
      "schema": "BudgetTarget",
      "description": "Collection of saving target action plans"
    },
    "/exams_payments/{paymentId}": {
      "schema": "ExamsPayment",
      "description": "Collection of pupil exam fee collections"
    },
    "/exams_expenses/{expenseId}": {
      "schema": "ExamsExpense",
      "description": "Collection of exams print orders/invoices logs"
    },
    "/exams_settings/{settingsId}": {
      "schema": "ExamsSettings",
      "description": "Collection of default assessment standard prices"
    },
    "/terms/{termId}": {
      "schema": "Term",
      "description": "Collection of active/inactive school terms"
    },
    "/teacher_evaluations/{evaluationId}": {
      "schema": "TeacherEvaluation",
      "description": "Collection of teacher moral & attendance evaluations"
    },
    "/auditLogs/{logId}": {
      "schema": "AuditLog",
      "description": "Collection of system critical actions audit trails"
    }
  }
}
